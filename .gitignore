# .gitignore para o projeto Promptuario DSD
# Ignora artefatos comuns de Python, ambientes virtuais, Docker e IDEs

# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
ENV/
env/
.venv/
*/.venv/

# Distribution / packaging
build/
dist/
*.egg-info/
pip-wheel-metadata/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
nosetests.xml
htmlcov/

# Mypy / type checkers
.mypy_cache/
.pyre/
.pytype/

# PyInstaller
*.manifest
*.spec

# Logs
*.log
logs/

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# Environment variables / secrets
.env
.env.*
local_settings.py
secrets.json

# Docker
docker-compose.override.yml
**/docker-compose.override.yml

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
**/.vite/

# Jupyter
.ipynb_checkpoints/

# Compiled C extensions
*.so
*.dylib

# Database
*.sqlite3
*.db

PROMPTUARIO_Status_Implementacao.md
PROMPTUARIO_Prompts_Final_Developer.md
PROMPTUARIO_Prompts_Faltantes.md
DEPLOY.md
DEPLOY_DUAS_VMS.md
GUIA_MUDANCA_IP_AWS.md
IDEIAS_DE_EVOLUCAO.md