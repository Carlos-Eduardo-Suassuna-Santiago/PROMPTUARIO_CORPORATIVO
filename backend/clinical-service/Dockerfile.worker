FROM python:3.12-slim

WORKDIR /app

# WeasyPrint precisa de libs do sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev \
    libpango-1.0-0 libpangocairo-1.0-0 libcairo2 \
    libgdk-pixbuf-2.0-0 libffi-dev shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

# Instala dependências
COPY clinical-service/requirements.txt .
RUN pip install --default-timeout=120 --no-cache-dir -r requirements.txt

# Copia shared e o serviço
COPY shared /app/shared
COPY clinical-service .

RUN useradd -m -u 1001 appuser && chown -R appuser:appuser /app
USER appuser

CMD ["celery", "-A", "app.workers.celery_app.celery_app", "worker", \
     "--loglevel=info", "--concurrency=2", "-Q", "celery"]