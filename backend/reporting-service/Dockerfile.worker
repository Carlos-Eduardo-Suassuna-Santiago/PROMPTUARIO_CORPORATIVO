FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev libpango-1.0-0 libpangocairo-1.0-0 \
    libcairo2 libgdk-pixbuf-xlib-2.0-0 libffi-dev shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

COPY reporting-service/requirements.txt .
RUN pip install --default-timeout=120 --no-cache-dir -r requirements.txt

COPY shared /app/shared
COPY reporting-service/app ./app

RUN useradd -m -u 1001 appuser && chown -R appuser:appuser /app
USER appuser

# Celery worker entry point
CMD ["celery", "-A", "app.workers.celery_tasks.celery_app", "worker", \
     "--loglevel=info", "--concurrency=4", "-Q", "celery"]
